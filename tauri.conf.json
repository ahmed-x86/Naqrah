{
  "$schema": "https://schema.tauri.app/2.0.0/tauri.configuration.schema.json",
  "productName": "Naqrah",
  "version": "1.0.0",
  "identifier": "com.naqrah.dev",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Naqrah - نقرة",
        "width": 900,
        "height": 600,
        "minWidth": 850,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default capability",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "store:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "icon": [
      "icon.ico",
      "iconn.png"
    ],
    "category": "Utility",
    "linux": {
      "deb": {
        "desktopTemplate": "naqrah.desktop"
      },
      "rpm": {
        "desktopTemplate": "naqrah.desktop"
      }
    }
  }
}